<robot name="robot_b" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="robot_b" params="prefix">
        <material name="blue">
            <color rgba="0 0 .8 1"/>
        </material>
        <material name="red">
            <color rgba="1 0 0 1"/>
        </material>
        
        <link name="${prefix}link0_passive">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.0" radius="0.0"/>
                </geometry>
            </visual>
        </link>
        <link name="${prefix}link0_x_axis">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder length="0.0" radius="0.0"/>
                </geometry>
            </visual>
        </link>
        <joint name="${prefix}q0_x" type="fixed">
            <origin xyz="0 0 0" rpy="0 1.571 0"/>
            <parent link="${prefix}link0_passive"/>
            <child link="${prefix}link0_x_axis"/>
        </joint>

        <link name="${prefix}link1"/>
        <link name="${prefix}link1_x_axis">
            <visual>
                <origin xyz="0 0 0.25" rpy="0 0 0"/>
                <material name="red"/>
                <geometry>
                    <cylinder length="0.5" radius="0.05"/>
                </geometry>
            </visual>
        </link>
        <joint name="${prefix}q1" type="revolute">
            <origin xyz="0 0 0.5" rpy="0 0 0"/>
            <parent link="${prefix}link0_passive"/>
            <child link="${prefix}link1"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.0"/>
        </joint>
        <joint name="${prefix}q1_passive" type="fixed">
            <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
            <parent link="${prefix}link1"/>
            <child link="${prefix}link1_passive"/>
        </joint>
        <link name="${prefix}link1_passive">
            <visual>
                <origin xyz="0 0 0.25" rpy="0 0 0"/>
                <material name="blue"/>
                <geometry>
                    <cylinder length="0.5" radius="0.05"/>
                </geometry>
            </visual>
        </link>
        <joint name="${prefix}q1_x" type="fixed">
            <origin xyz="0 0 0" rpy="0 1.571 0"/>
            <parent link="${prefix}link1_passive"/>
            <child link="${prefix}link1_x_axis"/>
        </joint>

        <link name="${prefix}link2"/>
        <link name="${prefix}link2_x_axis">
            <visual>
                <origin xyz="0 0 0.25" rpy="0 0 0"/>
                <material name="red"/>
                <geometry>
                    <cylinder length="0.5" radius="0.05"/>
                </geometry>
            </visual>
        </link>
        <joint name="${prefix}q2" type="revolute">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <parent link="${prefix}link1_passive"/>
            <child link="${prefix}link2"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.0"/>
        </joint>
        <joint name="${prefix}q2_passive" type="fixed">
            <origin xyz="-1.3 0 0" rpy="0 0 0"/>
            <parent link="${prefix}link2"/>
            <child link="${prefix}link2_passive"/>
        </joint>
        <link name="${prefix}link2_passive">
            <visual>
                <origin xyz="0 0 0.25" rpy="0 0 0"/>
                <material name="blue"/>
                <geometry>
                    <cylinder length="0.5" radius="0.05"/>
                </geometry>
            </visual>
        </link>
        <joint name="${prefix}q2_x" type="fixed">
            <origin xyz="0 0 0" rpy="0 1.571 0"/>
            <parent link="${prefix}link2_passive"/>
            <child link="${prefix}link2_x_axis"/>
        </joint>

        <link name="${prefix}link3"/>
        <link name="${prefix}link3_x_axis">
            <visual>
                <origin xyz="0 0 0.25" rpy="0 0 0"/>
                <material name="red"/>
                <geometry>
                    <cylinder length="0.5" radius="0.05"/>
                </geometry>
            </visual>
        </link>
        <joint name="${prefix}q3" type="revolute">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <parent link="${prefix}link2_passive"/>
            <child link="${prefix}link3"/>
            <axis xyz="0 0 1"/>
            <limit lower="-1.57" upper="1.57" effort="1.0" velocity="1.0"/>
        </joint>
        <joint name="${prefix}q3_passive" type="fixed">
            <origin xyz="-0.9 0 0" rpy="0 0 0"/>
            <parent link="${prefix}link3"/>
            <child link="${prefix}link3_passive"/>
        </joint>
        <link name="${prefix}link3_passive">
            <visual>
                <origin xyz="0 0 0.25" rpy="0 0 0"/>
                <material name="blue"/>
                <geometry>
                    <cylinder length="0.5" radius="0.05"/>
                </geometry>
            </visual>
        </link>
        <joint name="${prefix}q3_x" type="fixed">
            <origin xyz="0 0 0" rpy="0 1.571 0"/>
            <parent link="${prefix}link3_passive"/>
            <child link="${prefix}link3_x_axis"/>
        </joint>
    </xacro:macro>
</robot>